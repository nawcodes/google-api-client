# Google Drive CLI Configuration
# Copy this file to .env and adjust paths if you don't use default ~/.config/gdrive/

# Optional: Path to OAuth token JSON file
# If unset, the CLI searches:
#   1. --token <path>
#   2. ./token.json or ./google_token.json
#   3. ~/.config/gdrive/token.json
GDRIVE_TOKEN_PATH=~/.config/gdrive/token.json

# Optional: Path to OAuth Client Secret JSON (downloaded from GCP Console)
GDRIVE_CLIENT_SECRET_PATH=./client_secret.json
